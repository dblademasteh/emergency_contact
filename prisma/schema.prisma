generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ContactType {
  value     String   @id
  label     String
  color     String   @default("slate")
  icon      String   @default("more")
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts Contact[]
  groups   Group[]

  @@map("contact_types")
}

model Admin {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model User {
  id           String   @id @default(cuid())
  office       String
  unitCode     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Group {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("OTHER")
  logoUrl   String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Group?       @relation("GroupTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Group[]      @relation("GroupTree")
  contacts Contact[]
  typeInfo ContactType @relation(fields: [type], references: [value])

  @@index([parentId, sortOrder])
  @@index([type])
  @@map("groups")
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  phone       String
  type        String   @default("OTHER")
  note        String?
  logoUrl     String?
  latitude    Float?
  longitude   Float?
  facebookUrl String?
  isPrimary   Boolean  @default(false)
  sortOrder   Int      @default(0)
  groupId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group    Group?      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  typeInfo ContactType @relation(fields: [type], references: [value])

  @@index([type, sortOrder])
  @@index([groupId])
  @@map("contacts")
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model FaqItem {
  id        String   @id @default(cuid())
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("faq_items")
}

model Suggestion {
  id        String   @id @default(cuid())
  message   String
  office    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("suggestions")
}

model BfpCornerEntry {
  id        String   @id @default(cuid())
  title     String
  youtubeUrl String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("bfp_corner_entries")
}
