# Copy this file to a real `.env` next to `docker-compose.yml`
# Compose automatically reads `.env` for the ${...} values below.
# WARNING: never commit the real `.env` to git (it is gitignored).

# Postgres superuser credentials (kept internal to the Docker network)
POSTGRES_USER=emergency
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=emergency_contacts

# Auth signing secret - MUST be a long random hex string.
# Generate one with: openssl rand -hex 32   (on Windows: `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`)
SESSION_SECRET=CHANGE_ME_openssl_rand_hex_32

# Cloudflare Tunnel token (remotely-managed tunnel). Get it from:
# Zero Trust → Networks → Tunnels → <your tunnel> → Overview → Configure → Docker,
# copy the `--token eyJ...` value. If the token expires, refresh it there and
# update this value, then run `docker compose up -d cloudflared`.
CLOUDFLARED_TOKEN=CHANGE_ME_eyJ_cloudflare_tunnel_token